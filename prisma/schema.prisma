// PIXEL Master — Database Schema
// كل بيانات الموقع (أعمال، أسعار، خدمات، طلبات) تأتي من هنا — لا شيء ثابت في الكود.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// المستخدمون (مدير / عميل)
// ------------------------------------------------------------------
enum UserRole {
  ADMIN
  CUSTOMER
}

model User {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  telegram      String?
  email         String?  @unique
  passwordHash  String
  role          UserRole @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
}

// ------------------------------------------------------------------
// التصنيفات
// ------------------------------------------------------------------
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  works     Work[]
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------------
// الخدمات (Admin → Services)
// ------------------------------------------------------------------
model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  iconMediaId String?
  iconMedia   Media?   @relation(fields: [iconMediaId], references: [id])
  isVisible   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------------------
// مكتبة الوسائط — كل ملف مرفوع (صورة/فيديو/غلاف/ملف أصلي)
// ------------------------------------------------------------------
enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Media {
  id          String    @id @default(cuid())
  type        MediaType
  url         String    // رابط عام (preview محسّن)
  secureKey   String?   // مفتاح التخزين الخاص بالملف الأصلي (غير عام)
  width       Int?
  height      Int?
  sizeBytes   Int?
  originalName String?
  createdAt   DateTime  @default(now())

  worksAsPreview Work[]  @relation("PreviewMedia")
  worksAsOriginal Work[] @relation("OriginalMedia")
  services       Service[]
  paymentProofOrders Order[] @relation("PaymentProofMedia")
  deliverableOrders  Order[] @relation("DeliverableMedia")
}

// ------------------------------------------------------------------
// الأعمال (المعرض / المنتجات القابلة للطلب)
// ------------------------------------------------------------------
enum WorkKind {
  IMAGE
  VIDEO
}

enum WorkStatus {
  PUBLISHED
  HIDDEN
}

model Work {
  id            String     @id @default(cuid())
  title         String
  description   String
  kind          WorkKind
  status        WorkStatus @default(HIDDEN)

  categoryId    String
  category      Category   @relation(fields: [categoryId], references: [id])

  previewMediaId  String
  previewMedia    Media    @relation("PreviewMedia", fields: [previewMediaId], references: [id])

  originalMediaId String?  // الملف الأصلي إن كان للبيع (رابط غير عام)
  originalMedia   Media?   @relation("OriginalMedia", fields: [originalMediaId], references: [id])

  price         Decimal?   @db.Decimal(10, 2)
  keywords      String[]   @default([])

  viewCount     Int        @default(0)
  orderCount    Int        @default(0)

  pricingPlans  PricingPlan[]  @relation("WorkPricingPlans")
  orders        Order[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// ------------------------------------------------------------------
// الباقات (Daily / Weekly / Monthly / مخصصة)
// ------------------------------------------------------------------
model PricingPlan {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  durationDays Int
  isActive    Boolean  @default(true)
  order       Int      @default(0)

  works       Work[]   @relation("WorkPricingPlans")
  orders      Order[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------------------
// طرق الدفع اليدوية
// ------------------------------------------------------------------
model PaymentMethod {
  id            String   @id @default(cuid())
  name          String   // "SHAM CASH" / "SYRIATEL CASH"
  accountNumber String
  instructions  String
  qrMediaId     String?
  isActive      Boolean  @default(true)
  order         Int      @default(0)

  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ------------------------------------------------------------------
// الطلبات
// ------------------------------------------------------------------
enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_UNDER_REVIEW
  PAYMENT_CONFIRMED
  IN_PROGRESS
  READY_FOR_DELIVERY
  COMPLETED
  REJECTED
  CANCELLED
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     Int          @unique @default(autoincrement())

  customerId      String
  customer        User         @relation(fields: [customerId], references: [id])

  workId          String?
  work            Work?        @relation(fields: [workId], references: [id])

  pricingPlanId   String?
  pricingPlan     PricingPlan? @relation(fields: [pricingPlanId], references: [id])

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  price           Decimal      @db.Decimal(10, 2)
  notes           String?

  paymentProofMediaId String?
  paymentProofMedia   Media?   @relation("PaymentProofMedia", fields: [paymentProofMediaId], references: [id])

  deliverableMediaId  String?  // الملف النهائي المسلَّم للعميل
  deliverableMedia    Media?   @relation("DeliverableMedia", fields: [deliverableMediaId], references: [id])

  status          OrderStatus  @default(AWAITING_PAYMENT)
  statusHistory   OrderStatusEvent[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

// ------------------------------------------------------------------
// إعدادات الموقع العامة (Homepage / Branding) — مفتاح/قيمة مرن
// ------------------------------------------------------------------
model SiteSetting {
  key       String   @id  // مثال: "site_name", "hero_title", "logo_media_id"
  value     String
  updatedAt DateTime @updatedAt
}
